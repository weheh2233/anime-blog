---
import { LOCAL_MUSIC } from '../lib/localMusic';
---

<audio id="global-music-audio" preload="metadata" aria-hidden="true" transition:persist></audio>

<script define:vars={{ tracks: LOCAL_MUSIC }}>
  const bootLocalMusic = () => {
    if (window.__musicPlayer) return;
    const audio = document.getElementById('global-music-audio');
    if (!audio) return;

    const getInitialIndex = () => {
      if (!tracks.length) return -1;

      const storedIndex = Number(window.sessionStorage.getItem('local_music_current_index'));
      if (Number.isInteger(storedIndex) && storedIndex >= 0 && storedIndex < tracks.length) {
        return storedIndex;
      }

      const randomIndex = Math.floor(Math.random() * tracks.length);
      window.sessionStorage.setItem('local_music_current_index', String(randomIndex));
      return randomIndex;
    };

    const initialIndex = getInitialIndex();

    let state = {
      tracks,
      currentIndex: initialIndex,
      currentTrack: initialIndex >= 0 ? tracks[initialIndex] : null,
      currentTime: 0,
      duration: initialIndex >= 0 ? tracks[initialIndex].duration : 0,
      status: tracks.length ? 'ready' : 'error',
      error: tracks.length ? null : 'No local music is configured',
    };
    const listeners = new Set();

    const emit = () => {
      window.dispatchEvent(new CustomEvent('music:state-change', { detail: state }));
      listeners.forEach((listener) => listener(state));
    };

    const setState = (patch) => {
      state = { ...state, ...patch };
      emit();
    };

    const setTrack = (index) => {
      if (!state.tracks.length) return;
      const currentIndex = (index + state.tracks.length) % state.tracks.length;
      const currentTrack = state.tracks[currentIndex];
      audio.src = currentTrack.url;
      window.sessionStorage.setItem('local_music_current_index', String(currentIndex));
      setState({
        currentIndex,
        currentTrack,
        currentTime: 0,
        duration: currentTrack.duration || 0,
        status: 'ready',
        error: null,
      });
    };

    const play = async () => {
      if (!state.currentTrack) {
        setState({ status: 'error', error: 'No local music is configured' });
        return;
      }

      if (!audio.src) audio.src = state.currentTrack.url;
      try {
        await audio.play();
        setState({ status: 'playing', error: null });
      } catch {
        setState({ status: 'blocked', error: 'Playback was blocked. Click play to start.' });
      }
    };

    const pause = () => {
      audio.pause();
      setState({ status: 'paused' });
    };

    const next = async () => {
      setTrack(state.currentIndex + 1);
      await play();
    };

    const previous = async () => {
      setTrack(state.currentIndex - 1);
      await play();
    };

    const syncTime = () => {
      setState({
        currentTime: Number.isFinite(audio.currentTime) ? audio.currentTime : 0,
        duration: Number.isFinite(audio.duration) ? audio.duration : (state.currentTrack?.duration || 0),
      });
    };

    const seek = (time) => {
      if (!Number.isFinite(time)) return;
      const duration = Number.isFinite(audio.duration) ? audio.duration : state.duration;
      const nextTime = Math.max(0, Math.min(time, duration || time));
      audio.currentTime = nextTime;
      setState({ currentTime: nextTime });
    };

    audio.addEventListener('play', () => setState({ status: 'playing', error: null }));
    audio.addEventListener('pause', () => {
      if (!audio.ended) setState({ status: 'paused' });
    });
    audio.addEventListener('loadedmetadata', syncTime);
    audio.addEventListener('durationchange', syncTime);
    audio.addEventListener('timeupdate', syncTime);
    audio.addEventListener('seeking', syncTime);
    audio.addEventListener('seeked', syncTime);
    audio.addEventListener('ended', () => { void next(); });
    audio.addEventListener('error', () => {
      setState({ status: 'error', error: 'This audio file could not be played.' });
    });

    window.__musicPlayer = {
      getState: () => state,
      play,
      pause,
      toggle: async () => (state.status === 'playing' ? pause() : play()),
      next,
      previous,
      seek,
      subscribe: (listener) => {
        listeners.add(listener);
        listener(state);
        return () => listeners.delete(listener);
      },
    };

    emit();
  };

  bootLocalMusic();
  document.addEventListener('astro:page-load', bootLocalMusic);

  // Splash animation: 5000ms, then 500ms fade-out.
  window.setTimeout(() => {
    if (window.__musicPlayer) void window.__musicPlayer.play();
  }, 5500);
</script>

<style>
  #global-music-audio {
    position: fixed;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
</style>
