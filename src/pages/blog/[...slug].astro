---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import GiscusComments from '../../components/GiscusComments.astro';
import { Image } from 'astro:assets';
import { resolveHeroImage } from '../../lib/imageMap';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const resolvedHeroImage = resolveHeroImage(post.data.heroImage, post.id);
---

<BaseLayout title={post.data.title} description={post.data.description} showToc>
  <ReadingProgress />
  <article class="max-w-5xl mx-auto w-full min-w-0" itemscope itemtype="https://schema.org/Article">
    <!-- 文章主体（data-pagefind-body 限制只索引此区域） -->
    <div data-pagefind-body class="min-w-0">
    <!-- 文章头 -->
    <header class="mb-10">
      <h1 class="text-3xl md:text-4xl font-bold mb-4 leading-tight" style="color: var(--blog-text-primary);" itemprop="headline">
        {post.data.pinned && <span class="inline-block mr-2 text-lg" style="color: var(--blog-accent);">置顶</span>}
        {post.data.title}
      </h1>

      <div class="flex flex-wrap items-center gap-3 text-sm" style="color: var(--blog-text-tertiary);">
        <span itemprop="author">作者：{post.data.author}</span>

        <span>路</span>

        <time itemprop="datePublished" datetime={post.data.publishDate.toISOString()}>
          {post.data.publishDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>

        {post.data.zone && (
          <>
            <span>·</span>
            <span class="px-2 py-0.5 rounded-[var(--blog-radius-sm)] text-xs" style="background: var(--blog-accent-light); color: var(--blog-accent);">
              {post.data.zone}
            </span>
          </>
        )}

        <span>·</span>
        <span>预计阅读 5 分钟</span>
      </div>

      <!-- 标签 -->
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="flex gap-2 mt-4">
          {post.data.tags.map(tag => (
            <a
              href={`/tags/${encodeURIComponent(tag)}`}
              class="text-xs px-2 py-1 rounded-[var(--blog-radius-sm)] no-underline transition-colors"
              style="background: var(--blog-accent-lighter); color: var(--blog-text-tertiary);"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}
    </header>

    <!-- 文章封面图：imageMap 图用 <Image> 做 responsive 适配，Keystatic 图用 <img> -->
    {resolvedHeroImage && (
      <div class="mb-10 rounded-[var(--blog-radius-xl)] overflow-hidden">
        {typeof resolvedHeroImage === 'string' ? (
          <img src={resolvedHeroImage} alt={post.data.title} class="w-full aspect-[21/9] object-cover" />
        ) : (
          <Image src={resolvedHeroImage} alt={post.data.title} width={1050} height={450} class="w-full aspect-[21/9] object-cover" />
        )}
      </div>
    )}

    <!-- Markdown 内容 -->
    <div class="prose-custom max-w-none min-w-0" itemprop="articleBody">
      <Content />
    </div>

    <!-- 文章末尾分隔 -->
    </div>
    <hr class="my-12" style="border-color: var(--blog-border);" />

    <!-- 评论区 -->
    <div id="comments" class="mt-8">
      <h2 class="text-lg font-bold mb-4" style="color: var(--blog-text-primary);">💬 评论</h2>
      <GiscusComments />
    </div>
  </article>
</BaseLayout>

<style is:global>
  /* ===== 文章主区域毛玻璃底衬 ===== */
  article.max-w-5xl {
    width: 100%;
    max-width: min(64rem, 100%);
    min-width: 0;
    box-sizing: border-box;
    background: var(--blog-glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--blog-glass-border);
    border-radius: var(--blog-radius-xl);
    padding: 1.5rem 1.25rem;
  }

  @media (min-width: 640px) {
    article.max-w-5xl {
      padding: 2rem 2.5rem;
    }
  }

  .prose-custom {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
    overflow-wrap: break-word;
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--blog-text-primary);
  }
  .prose-custom h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--blog-border);
  }
  .prose-custom h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .prose-custom p { margin-bottom: 1rem; }
  .prose-custom a {
    color: var(--blog-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose-custom a:hover { opacity: 0.8; }
  .prose-custom code {
    font-family: var(--blog-font-mono);
    font-size: 0.9em;
    padding: 0.2em 0.4em;
    border-radius: 4px;
    color: var(--blog-code-text);
    background: var(--blog-code-bg);
    border: 1px solid var(--blog-code-border);
  }
  .prose-custom pre {
    max-width: 100%;
    box-sizing: border-box;
    padding: 1rem;
    border-radius: var(--blog-radius-md);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    -webkit-overflow-scrolling: touch;
    margin: 1.5rem 0;
    color: var(--blog-code-text);
    background: var(--blog-code-bg);
    border: 1px solid var(--blog-code-border);
  }
  .prose-custom pre.astro-code {
    padding: 0;
    background: var(--blog-code-bg) !important;
    color: var(--blog-code-text) !important;
    border-color: var(--blog-code-border);
    counter-reset: code-line;
  }
  .prose-custom pre code {
    display: block;
    min-width: max-content;
    white-space: pre;
    overflow-wrap: normal;
    word-break: normal;
    background: none;
    padding: 0;
    font-size: 0.875rem;
    border: 0;
  }
  .prose-custom pre.astro-code code {
    padding: 0.95rem 0;
  }
  .prose-custom pre.astro-code .line {
    display: block;
    position: relative;
    min-height: 1.5em;
    padding: 0 1rem 0 3.75rem;
  }
  .prose-custom pre.astro-code .line::before {
    content: counter(code-line);
    counter-increment: code-line;
    position: absolute;
    inset: 0 auto 0 0;
    width: 3rem;
    padding-right: 0.75rem;
    color: var(--blog-code-gutter);
    border-right: 1px solid color-mix(in srgb, var(--blog-code-border) 85%, transparent);
    text-align: right;
    user-select: none;
  }
  .prose-custom pre.astro-code span {
    color: var(--shiki-light) !important;
  }
  :root.dark .prose-custom pre.astro-code span {
    color: var(--shiki-dark) !important;
  }
  .prose-custom pre.raw-code-block {
    padding: 0;
    background: var(--blog-code-bg);
    color: var(--blog-code-text);
  }
  .prose-custom pre.raw-code-block .raw-code {
    padding: 0.95rem 0;
  }
  .prose-custom pre.raw-code-block .line {
    display: block;
    position: relative;
    min-height: 1.5em;
    padding: 0 1rem 0 3.75rem;
  }
  .prose-custom pre.raw-code-block .line-number {
    position: absolute;
    inset: 0 auto 0 0;
    width: 3rem;
    padding-right: 0.75rem;
    color: var(--blog-code-gutter);
    border-right: 1px solid color-mix(in srgb, var(--blog-code-border) 85%, transparent);
    text-align: right;
    user-select: none;
  }
  .prose-custom pre.raw-code-block .line-content {
    white-space: pre;
  }
  .prose-custom blockquote {
    border-left: 3px solid var(--blog-accent);
    background: var(--blog-quote-bg);
    padding-left: 1rem;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
    margin: 1.5rem 0;
    color: var(--blog-text-secondary);
    font-style: italic;
  }
  .prose-custom img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    border-radius: var(--blog-radius-md);
    margin: 1.5rem 0;
  }
  .prose-custom table {
    max-width: 100%;
    border-collapse: collapse;
    background: var(--blog-surface);
    border: 1px solid var(--blog-border);
  }
  .prose-custom th,
  .prose-custom td {
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--blog-border);
    text-align: left;
  }
  .prose-custom th {
    color: var(--blog-text-primary);
    background: var(--blog-accent-light);
    font-weight: 700;
  }
  .prose-custom iframe,
  .prose-custom video,
  .prose-custom embed,
  .prose-custom object {
    display: block;
    max-width: 100%;
    box-sizing: border-box;
  }
  .prose-custom ul, .prose-custom ol {
    padding-left: 1.5rem;
    margin: 1rem 0;
  }
  .prose-custom li { margin-bottom: 0.25rem; }
  .prose-custom hr {
    border: none;
    border-top: 1px solid var(--blog-border);
    margin: 2rem 0;
  }

  @media (max-width: 640px) {
    article.max-w-5xl {
      margin-left: 0;
      margin-right: 0;
      padding: 1rem;
      border-radius: var(--blog-radius-lg);
    }

    .prose-custom {
      font-size: 1rem;
    }

    .prose-custom table {
      display: block;
      width: 100%;
      max-width: 100%;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      -webkit-overflow-scrolling: touch;
    }

    .prose-custom th,
    .prose-custom td {
      white-space: nowrap;
    }

    .prose-custom pre {
      margin: 1rem 0;
      padding: 0.875rem;
      font-size: 0.8125rem;
    }

    .prose-custom pre.astro-code {
      padding: 0;
    }

    .prose-custom pre code {
      font-size: 0.8125rem;
    }

    .prose-custom pre.astro-code code {
      padding: 0.75rem 0;
    }

    .prose-custom pre.astro-code .line {
      padding-left: 3.25rem;
      padding-right: 0.75rem;
    }

    .prose-custom pre.astro-code .line::before {
      width: 2.5rem;
      padding-right: 0.625rem;
    }

    .prose-custom pre.raw-code-block {
      padding: 0;
    }

    .prose-custom pre.raw-code-block .raw-code {
      padding: 0.75rem 0;
    }

    .prose-custom pre.raw-code-block .line {
      padding-left: 3.25rem;
      padding-right: 0.75rem;
    }

    .prose-custom pre.raw-code-block .line-number {
      width: 2.5rem;
      padding-right: 0.625rem;
    }

    .prose-custom img,
    .prose-custom iframe,
    .prose-custom video,
    .prose-custom embed,
    .prose-custom object {
      max-width: 100%;
    }
  }
</style>

<script>
  function addRawCodeLineNumbers() {
    document.querySelectorAll('.prose-custom pre[data-language]:not(.astro-code)').forEach((pre) => {
      if (pre.dataset.lineNumbered === 'true') return;

      const source = (pre.textContent || '').replace(/\n$/, '');
      const code = document.createElement('code');
      code.className = 'raw-code';

      source.split('\n').forEach((line, index) => {
        const row = document.createElement('span');
        row.className = 'line';

        const number = document.createElement('span');
        number.className = 'line-number';
        number.textContent = String(index + 1);

        const content = document.createElement('span');
        content.className = 'line-content';
        content.textContent = line || '\u200b';

        row.append(number, content);
        code.append(row);
      });

      pre.replaceChildren(code);
      pre.classList.add('raw-code-block');
      pre.dataset.lineNumbered = 'true';
    });
  }

  addRawCodeLineNumbers();
  document.addEventListener('astro:page-load', addRawCodeLineNumbers);
</script>
