---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import ScrollReveal from '../../components/ScrollReveal.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts', ({ data }) => !data.draft);

// 聚合所有标签 + 计数
const tagMap = new Map<string, number>();
posts.forEach((post) => {
  post.data.tags?.forEach((tag) => {
    tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
  });
});

const allTags = Array.from(tagMap.entries())
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count);

---

<BaseLayout title="标签" description="文章标签聚合">
  <div class="max-w-3xl mx-auto">
    <h1 class="text-3xl font-bold mb-2" style="color: var(--blog-text-primary);">🏷️ 标签</h1>
    <p class="text-sm mb-8" style="color: var(--blog-text-secondary);">所有标签的聚合页</p>

    <div class="tag-cloud" aria-label="标签词云">
      {allTags.map((tag, i) => (
        <ScrollReveal delay={(i % 4 + 1) as 0 | 1 | 2 | 3}>
          <a
            href={`/tags/${encodeURIComponent(tag.name)}`}
            class="tag-cloud-item inline-flex items-center gap-2 no-underline transition-all hover:-translate-y-0.5"
          >
            <span># {tag.name}</span>
            <span class="tag-count">
              {tag.count}
            </span>
          </a>
        </ScrollReveal>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 1.15rem;
    padding: 2rem 1rem;
  }

  .tag-cloud :global(.reveal) {
    display: inline-flex;
    width: auto;
    justify-content: center;
  }

  .tag-cloud-item {
    justify-self: center;
    max-width: 100%;
    padding: 0.45rem 0.65rem;
    border: 1px solid color-mix(in srgb, var(--blog-accent) 22%, transparent);
    border-radius: var(--blog-radius-full);
    background: color-mix(in srgb, var(--blog-surface) 76%, transparent);
    color: var(--blog-accent);
    line-height: 1.25;
    white-space: nowrap;
    overflow-wrap: anywhere;
    box-shadow: 0 3px 12px color-mix(in srgb, var(--blog-text-primary) 7%, transparent);
  }

  .tag-cloud-item:hover {
    border-color: var(--blog-accent);
    background: var(--blog-accent-light);
    box-shadow: 0 7px 18px color-mix(in srgb, var(--blog-accent) 16%, transparent);
  }

  .tag-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.35rem;
    height: 1.35rem;
    padding: 0 0.3rem;
    border-radius: 999px;
    background: var(--blog-accent-lighter);
    color: var(--blog-accent);
    font-size: 0.68em;
    line-height: 1;
  }

  @media (max-width: 640px) {
    .tag-cloud {
      justify-content: flex-start;
      gap: 0.65rem 0.4rem;
      padding: 1.25rem 0;
    }
    .tag-cloud-item { padding-inline: 0.5rem; }
  }
</style>
